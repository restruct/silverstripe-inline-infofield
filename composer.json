{
  "name": "restruct/silverstripe-inline-infofield",
  "description": "CMS form fields for help text: InfoField (a styled info box) and InlineInfoField (an info icon next to another field's label that shows its text on hover or tap)",
  "license": "MIT",
  "type": "silverstripe-vendormodule",
  "homepage": "https://github.com/restruct/silverstripe-inline-infofield",
  "keywords": [
    "silverstripe",
    "cms",
    "forms",
    "help",
    "info"
  ],
  "authors": [ { "name": "Restruct", "email": "dev@restruct.nl", "homepage": "https://restruct.nl" } ],
  "require": {
    "php": "^8.1",
    "silverstripe/vendor-plugin": "^2 || ^3",
    "silverstripe/framework": "^5 || ^6",
    "silverstripe/admin": "^2 || ^3"
  },
  "require-dev": {
    "silverstripe/recipe-testing": "^3 || ^4"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\InfoField\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\InfoField\\Tests\\": "tests/"
    }
  },
  "extra": {
    "expose": [
      "client/dist/js",
      "client/dist/css",
      "client/images"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
